# ---------------------------------------------------------------------------
# Frontend environment (Vite)
# ---------------------------------------------------------------------------
# Only VITE_-prefixed variables are exposed to the browser bundle. Never put a
# service-role key, a payment secret, or an SMTP password in this file — anything
# here ships to every visitor in plain text.

# Supabase project URL and PUBLIC anon/publishable key.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Base URL of the Express backend.
VITE_API_BASE_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Cohort countdown (optional — src/data/cohorts.ts holds the defaults)
# ---------------------------------------------------------------------------
# Full ISO 8601 WITH an explicit UTC offset. The offset is required: a bare
# "2026-10-09" is parsed as UTC midnight, which is 05:30 IST the same day.
VITE_COHORT_START_DATE=2026-10-09T00:00:00+05:30
VITE_COHORT_TIMEZONE_LABEL=IST
VITE_COHORT_NAME=October 2026 Cohort
