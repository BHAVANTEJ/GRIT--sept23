# ---------------------------------------------------------------------------
# Backend environment (server-only)
# ---------------------------------------------------------------------------
# Nothing in this file is ever exposed to the browser. In particular
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security completely — it must
# never be copied into frontend/.env or given a VITE_ prefix.
#
# SUPABASE_URL must point at the SAME project as frontend VITE_SUPABASE_URL,
# otherwise accounts created by one side are invisible to the other.

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
